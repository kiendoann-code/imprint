{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "imprint-store",
  "main": "dist-cloudflare/worker/index.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "dist-cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imprint-db",
      "database_id": "a8cad2d0-fb18-43ff-bbb3-b6fa6d92bb10",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "imprint-uploads"
    }
  ],
  "routes": [
    {
      "pattern": "imprint.io.vn",
      "custom_domain": true
    },
    {
      "pattern": "admin.imprint.io.vn",
      "custom_domain": true
    }
  ]
}
