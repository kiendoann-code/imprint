{
  "name": "imprint-store",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/backend.test.mjs tests/cloudflare-auth.test.mjs",
    "dev": "npm run build && node scripts/local-server.mjs",
    "dev:admin": "npm run build && node scripts/local-server.mjs --admin",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy": "npm run build:cloudflare && npx wrangler deploy",
    "db:migrate": "npx wrangler d1 migrations apply imprint-db --remote",
    "postinstall": "npm run build:cloudflare"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.44.5",
    "esbuild": "0.25.12",
    "wrangler": "4.147.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
